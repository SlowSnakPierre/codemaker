{
	"private": true,
	"name": "codemaker",
	"description": "CodeMaker - Your AI-Powered Code IDE",
	"version": "0.0.1",
	"type": "module",
	"author": "Codemaker",
	"main": "app/background.js",
	"scripts": {
		"engine": "bun scripts/engine/index.js",
		"dev": "bun engine dev",
		"build": "bun engine build",
		"build:mac": "bun run build --mac",
		"build:mac:universal": "bun run build --mac --universal",
		"build:win32": "bun run build --win --ia32",
		"build:win64": "bun run build --win --x64",
		"build:linux": "bun run build --linux",
		"build:all": "bun run build --all",
		"check": "concurrently -n \"LINT,TYPESCRIPT\" -c \"green,blue\" \"cd renderer && next lint\" \"bun run typecheck\"",
		"format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
		"format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
		"lint": "concurrently -n \"LINT\" -c \"green\" \"cd ./renderer && next lint\"",
		"lint:fix": "concurrently -n \"LINT\" -c \"green\" \"cd ./renderer && next lint --fix\"",
		"typecheck:main": "tsc --noEmit --project main/tsconfig.json",
		"typecheck:renderer": "cd renderer && tsc --noEmit",
		"typecheck": "concurrently -n \"MAIN,RENDERER\" -c \"blue,cyan\" \"bun run typecheck:main\" \"bun run typecheck:renderer\"",
		"validate": "concurrently -n \"TYPESCRIPT,LINT,PRETTIER\" -c \"blue,green,yellow\" \"bun run typecheck\" \"bun run lint\" \"bun run format:check\"",
		"prepare": "husky install",
		"release": "bun scripts/github/prepare-release.js",
		"new-branch": "bun scripts/github/create-branch.js",
		"new-pr": "bun scripts/github/create-pr.js",
		"postinstall": "electron-builder install-app-deps"
	},
	"dependencies": {
		"@babel/core": "^7.28.0",
		"@babel/plugin-transform-class-properties": "^7.27.1",
		"@babel/plugin-transform-object-rest-spread": "^7.28.0",
