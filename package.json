		"@babel/preset-env": "^7.28.0",
		"@babel/preset-typescript": "^7.27.1",
		"@babel/runtime-corejs3": "^7.28.2",
		"@hookform/resolvers": "^5.2.1",
		"@monaco-editor/react": "^4.7.0",
		"@radix-ui/react-accordion": "^1.2.11",
